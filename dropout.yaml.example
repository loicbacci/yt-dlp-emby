# yaml-language-server: $schema=schemas/dropout.schema.json
library: /path/to/dropout-library
old_dir: /path/to/old
# Omit library / old_dir / staging to use [fallback] in config.toml.
# staging: /var/tmp/yt-dlp-emby
cookies: dropout-cookies.txt
imports:
  - shows/dimension-20.yaml

# A root series: list is still valid; omit series: when imports already list every show.
series:
  - name: Game Changer
    path: Game Changer [tvdbid=361151]
    tvdb_id: 361151
    url: https://watch.dropout.tv/game-changer
    seasons:
      - dropout: 1
    tvdb_skip:
      - season: 0
        episodes: [12, 13, 14]
