{
  "name": "yt-dlp-emby-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engineStrict": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs');const p=require('path');const src='dist';const dest=p.join('..','src','yt_dlp_emby','server','static');fs.rmSync(dest,{recursive:true,force:true});fs.cpSync(src,dest,{recursive:true});\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check src",
    "format:check": "biome format src",
    "preview": "vite preview",
    "cosmos": "cosmos",
    "cosmos-export": "cosmos-export"
  },
  "dependencies": {
    "@tanstack/preact-query": "^5.103.1",
    "@tanstack/preact-query-persist-client": "^5.103.1",
    "@tanstack/preact-store": "^0.13.2",
    "@tanstack/query-sync-storage-persister": "^5.103.1",
    "preact": "^10.26.5",
    "preact-iso": "^2.9.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@preact/preset-vite": "^2.10.2",
    "@preact/signals": "^2.0.5",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^3.1.4",
    "jsdom": "^26.1.0",
    "react-cosmos": "^7.4.1",
    "react-cosmos-plugin-vite": "^7.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
