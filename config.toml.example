# Cookie paths are configured per provider in the web UI or root manifests.
# cookies = "cookies.txt"

# Directory of imported series fragments (relative to the data dir / cwd).
# shows_dir = "shows"

# Sonarr (used by the web UI Sonarr Check). Do not put the API key in dropout.yaml.
# sonarr_url = "http://localhost:8989"
# sonarr_api_key = "your-sonarr-api-key"

# Path fallbacks: used when youtube.yaml / dropout.yaml omit the matching key.
# YT_DLP_EMBY_* environment variables override both the manifest and this table.
[fallback]
library = "/path/to/library"
old_dir = "/path/to/old"
# Optional local disk for in-progress downloads (recommended when the library is on SMB/NFS).
# Prefer a local SSD. /var/tmp is usually larger than /tmp (often a tmpfs ramdisk).
# Size it for at least one 1080p episode plus merge temps (several GiB).
# If unset, the system temp directory is used.
# staging = "/var/tmp/yt-dlp-emby"
