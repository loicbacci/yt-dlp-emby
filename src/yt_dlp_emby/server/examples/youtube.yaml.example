# yaml-language-server: $schema=../../../../schemas/youtube.schema.json
library: /path/to/library
old_dir: /path/to/old
# Omit library / old_dir / staging to use [fallback] in config.toml.
# staging: /var/tmp/yt-dlp-emby
# cookies: cookies.txt
# Child files (series: only) use schemas/youtube-series.schema.json
# imports:
#   - shows/example-channel.yaml

series:
  - name: Example Channel
    # path: Example Channel [tvdbid=123]
    # tvdb_id: 123
    playlists:
      - url: https://www.youtube.com/playlist?list=PLxxxxxxxx
        season: 1
      - url: https://www.youtube.com/playlist?list=PLyyyyyyyy
        # season omitted: next unused season in this series folder
        # enabled: false
        # skip:
        #   - dQw4w9WgXcQ
