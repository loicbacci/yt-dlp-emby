{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "yt-dlp-emby Dropout manifest",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["series"] },
    { "required": ["imports"] }
  ],
  "properties": {
    "library": { "type": "string", "minLength": 1 },
    "old_dir": { "type": "string", "minLength": 1 },
    "cookies": { "type": "string", "minLength": 1 },
    "staging": { "type": "string", "minLength": 1 },
    "imports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/seriesItem" }
    }
  },
  "definitions": {
    "seriesItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "oneOf": [
        { "required": ["seasons"] },
        { "required": ["urls"] }
      ],
      "not": {
        "anyOf": [
          { "required": ["urls", "url"] },
          { "required": ["urls", "seasons"] }
        ]
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]*$",
          "not": { "pattern": "\\.\\." }
        },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "tvdb_id": { "type": "integer", "minimum": 1 },
        "tvdb_skip": {
          "type": "array",
          "items": { "$ref": "#/definitions/tvdbSkip" }
        },
        "seasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/season" }
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seasons"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "seasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/season" }
        }
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dropout": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1 },
        "to_season": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1 },
        "only_episodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "remap": {
          "type": "array",
          "items": { "$ref": "#/definitions/remap" }
        }
      }
    },
    "remap": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dropout_episode", "skip"],
          "properties": {
            "dropout_episode": { "type": "integer", "minimum": 1 },
            "skip": { "const": true },
            "title": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dropout_episode", "to_season", "to_episode"],
          "properties": {
            "dropout_episode": { "type": "integer", "minimum": 1 },
            "to_season": { "type": "integer", "minimum": 0 },
            "to_episode": { "type": "integer", "minimum": 1 },
            "title": { "type": "string", "minLength": 1 },
            "skip": { "type": "boolean" }
          }
        }
      ]
    },
    "tvdbSkip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season", "episodes"],
      "properties": {
        "season": { "type": "integer", "minimum": 0 },
        "episodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
